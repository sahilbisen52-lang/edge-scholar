# Environment variables for EdgeScholar
# Copy this file to .env and customize as needed

# Runtime preference: auto | qnn | onnx | llama_cpp | mock
EDGESCHOLAR_PREFERRED_RUNTIME=auto

# Offline mode (true/false)
EDGESCHOLAR_OFFLINE_MODE=false

# Chunk size (tokens, 100-2000)
EDGESCHOLAR_CHUNK_SIZE=600

# Retrieval top-K results
EDGESCHOLAR_RETRIEVAL_TOP_K=5

# LLM temperature (0.0-2.0)
EDGESCHOLAR_TEMPERATURE=0.15

# Max output tokens
EDGESCHOLAR_MAX_TOKENS=512

# Theme: dark | light
EDGESCHOLAR_THEME=dark
