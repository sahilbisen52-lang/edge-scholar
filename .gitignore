# EdgeScholar .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Model files (too large for git)
models/*.gguf
models/*.onnx
models/*.bin
models/*.pt
models/*.safetensors
models/model_manifest_cached.json

# Data directory (user data, not committed)
data/

# Settings
.env
config/settings.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store
*.localized

# Windows
Thumbs.db
Desktop.ini

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
*.log

# Distribution
*.dmg
*.exe
*.msi
